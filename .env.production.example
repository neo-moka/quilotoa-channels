# Minimal environment for a self-hosted deploy with docker-compose.production.yaml.
# Copy to .env on the server and fill in the values.
#
# Full list of options: .env.example

# --- App -------------------------------------------------------------------

# Alphanumeric only, no symbols. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Public URL of the installation. Used for links in outgoing emails and by the widget.
FRONTEND_URL=https://support.example.com

FORCE_SSL=true

# Set to 'true' only if you want anyone to be able to register.
ENABLE_ACCOUNT_SIGNUP=false

# --- Database --------------------------------------------------------------

# POSTGRES_DATABASE must match POSTGRES_DB in docker-compose.production.yaml.
# Without it Rails would default to 'chatwoot_production' and create a second database.
POSTGRES_DATABASE=chatwoot
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=

# --- Redis -----------------------------------------------------------------

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# --- Email -----------------------------------------------------------------
# Required in practice: without it agent invites and password resets cannot be sent.

MAILER_SENDER_EMAIL=Support <support@example.com>
SMTP_DOMAIN=example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Storage ---------------------------------------------------------------
# Attachments land in the storage_data volume. Switch to S3/GCS for durability.

ACTIVE_STORAGE_SERVICE=local

# --- Two-factor authentication ---------------------------------------------
# Required only if agents will use MFA. Generate with: rails db:encryption:init

# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
